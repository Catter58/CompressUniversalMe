{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "COMPRESSUM_BUILD_TESTS": "ON",
                "COMPRESSUM_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "COMPRESSUM_BUILD_TESTS": "OFF",
                "COMPRESSUM_BUILD_BENCHMARKS": "OFF"
            }
        },
        {
            "name": "release-static",
            "displayName": "Release (Static)",
            "inherits": "release",
            "cacheVariables": {
                "COMPRESSUM_STATIC_BINARY": "ON"
            }
        },
        {
            "name": "release-with-tests",
            "displayName": "Release with Tests",
            "inherits": "release",
            "cacheVariables": {
                "COMPRESSUM_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-static",
            "configurePreset": "release-static"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release-with-tests",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
